{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Togami windows (main, the desktop pet, the Ask chat and the screen snip) may do",
  "windows": [
    "main",
    "pet",
    "chat",
    "snip"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-start-dragging",
    "notification:default"
  ]
}
