{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Togami",
  "version": "0.1.0",
  "identifier": "dev.tisdani.togami",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Togami",
        "width": 1120,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "Focus timer and distraction blocker",
    "longDescription": "Togami blocks distracting apps and sites while you study, and makes quitting a session cost something.",
    "copyright": "© 2026 tisdanidev",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
